# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/.next-*/
/.next-demo/
/.next-public/
/.next-prod/
/.next-verify/
/.next-trade/
/.next-design/
/.next-owner/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local SQLite cache/ledger/scanner db — runtime state, not source
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm

# typescript
*.tsbuildinfo
next-env.d.ts
data/*.log
