{
  "name": "tide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "node scripts/server.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "scan": "tsx src/worker/scan.ts",
    "worker": "tsx src/worker/index.ts",
    "jobs": "tsx scripts/jobs.ts",
    "rescore": "tsx scripts/rescore.ts",
    "build-capabilities": "tsx scripts/build-capabilities.ts",
    "probe": "tsx scripts/probe.ts",
    "assert-nansen-only": "tsx scripts/assert-nansen-only.ts",
    "verify": "pnpm assert-nansen-only && pnpm typecheck && pnpm test && pnpm build",
    "backtest": "tsx scripts/backtest.ts",
    "export-demo": "tsx scripts/export-demo-history.ts",
    "dev:demo": "DEMO_MODE=1 NANSEN_API_KEY= TIDE_DB_PATH=./data/demo.db NEXT_DIST_DIR=.next-demo next dev --turbopack -p 3300",
    "screenshots": "tsx scripts/readme-assets/capture.ts && python3 scripts/readme-assets/make-gifs.py",
    "fetch-docs": "tsx scripts/fetch-docs.ts",
    "gen-api": "tsx scripts/gen-api.ts",
    "validate-api": "tsx scripts/validate-endpoints.ts",
    "sanitize-fixtures": "tsx scripts/sanitize-fixtures.ts",
    "storm-v2": "tsx scripts/storm-v2.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@solana/web3.js": "^1.99.0",
    "@tanstack/react-query": "^5.103.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.47.0",
    "next": "15.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/ui": "^5.0.1",
    "dotenv": "^18.0.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "prettier": "3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
