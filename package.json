{
  "name": "tide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "scan": "tsx src/worker/scan.ts",
    "scan:loop": "tsx src/worker/scan.ts --loop",
    "rescore": "tsx scripts/rescore.ts",
    "build-capabilities": "tsx scripts/build-capabilities.ts",
    "probe": "tsx scripts/probe.ts",
    "assert-nansen-only": "tsx scripts/assert-nansen-only.ts",
    "verify": "pnpm assert-nansen-only && pnpm typecheck && pnpm test && pnpm build",
    "backtest": "tsx scripts/backtest.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.103.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3": "^7.4.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "d3": "^7.9.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "next": "15.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.1",
    "dotenv": "^18.0.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
