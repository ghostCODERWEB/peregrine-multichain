# Required. Get one at https://app.nansen.ai (Settings -> API).
NANSEN_API_KEY=

# free | pro. Sizes the rate limiter: free is 15 req/s & 300 req/min,
# pro is 75 req/s & 1,500 req/min. Wrong value here either throttles you
# needlessly or gets you 429'd.
NANSEN_PLAN=free

# private | public (default public). Nansen's redistribution rules allow
# smart-money trades, holdings and labels only for the key owner's own
# ("internal") use. Set private ONLY for an instance that just you can
# reach; anything shared stays public: all-trader pressure, no fronts or
# trade tapes, labels stripped, "Powered by Nansen API" attribution.
TIDE_DISPLAY_MODE=public

# Public site: 1 serves anyone on this instance's key, usable only through
# its own pages. Forces the public view (overrides TIDE_DISPLAY_MODE=private),
# turns off wallet sign-in, bring-your-own-key, MCP, the public API, x402,
# trading, Smart Alerts and paid agent runs, answers /api only to same-origin
# browser requests with per-visitor rate limits, and sets strict security
# headers (src/middleware.ts). The key stays server-side.
TIDE_PUBLIC_SITE=0

# Daily Nansen credit budget for visitor traffic on the instance key (the
# scanner worker is not counted). Past it, pages serve the last cached data
# and say why; resets 00:00 UTC. Always on for a public site (default 1000);
# on other instances only when set.
WEB_DAILY_CREDIT_CAP=1000

# off disables wallet sign-in and bring-your-own-key without the rest of
# public-site mode.
TIDE_ACCOUNTS=

# Encrypts users' own Nansen API keys at rest (AES-256-GCM): 32 random
# bytes, e.g. `openssl rand -base64 32`. Without it, bring-your-own-key is
# off. Keep it secret; losing it orphans every stored key.
TIDE_KMS_KEY=

# Optional: a wallet address (EVM or Solana) that gets the owner view when
# it signs in, so the operator can use a public instance privately.
TIDE_OWNER_ADDRESS=

# 1 replays recorded fixtures instead of calling the live API. Lets a judge
# (or you, out of credits) run the whole app with no key and no spend.
DEMO_MODE=0

# x402 pay-per-call for keyless visitors (priced buttons; the visitor's own
# wallet pays Nansen in USDC after confirming). On by default outside
# DEMO_MODE; 0 hides the buttons. Per-call ceiling: $1, in code.
X402_ENABLED=1

# Hard ceiling on credits the backtest pipeline (Forecast Lab) may spend in
# one run. It estimates cost before running and aborts above this.
BACKTEST_CREDIT_CAP=600

# Max agent/fast calls (200 credits each) TIDE will make in a rolling hour,
# across the AI Anchor and "Ask the anchor" button combined. Reports are
# reused for an hour and only generated on a click, never on page load.
ANCHOR_MAX_PER_HOUR=3
# agent/expert costs 750 credits a question: questions per account per UTC day.
EXPERT_DAILY_CAP=2

# Most article summaries (search/web-fetch, 20 credits each) the token
# page may request in a rolling hour; owner and members only, on a click.
WEB_FETCH_MAX_PER_HOUR=10

# Credits the daily sector-membership job may spend (one token-screener
# call per Nansen sector, ~34).
SECTOR_REFRESH_CREDIT_CAP=60

# Scanner cadence in minutes (~15-35 credits per run; 30 = ~850/day).
SCAN_INTERVAL_MIN=30

# Storm sweep: every N hours the scanner scores the tokens smart money is
# dumping hardest (~17 credits each) so the home ticker has fresh scores.
STORM_SWEEP_HOURS=12
STORM_SWEEP_TOKENS=6

# Public origin of this instance (no trailing slash), e.g. https://peregrine.example.
# Used for page metadata and share links.
SITE_URL=

# Where the scanner/cache SQLite database lives. Relative to the repo root.
TIDE_DB_PATH=./data/tide.db

# Optional: only needed for "Set storm alert" delivery if you want alerts
# to reach a specific chat/webhook by default instead of asking the user
# for one each time.
TELEGRAM_DEFAULT_CHAT_ID=
DISCORD_DEFAULT_WEBHOOK_URL=
# Trading (M8): quotes, prepared transactions and broadcasts through Nansen; the user always signs in their own wallet.
FEATURE_TRADING=0
