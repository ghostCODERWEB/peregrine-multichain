# Required. Get one at https://app.nansen.ai (Settings -> API).
NANSEN_API_KEY=

# free | pro. Sizes the rate limiter: free is 15 req/s & 300 req/min,
# pro is 75 req/s & 1,500 req/min. Wrong value here either throttles you
# needlessly or gets you 429'd.
NANSEN_PLAN=free

# 1 replays recorded fixtures instead of calling the live API. Lets a judge
# (or you, out of credits) run the whole app with no key and no spend.
DEMO_MODE=0

# Hard ceiling on credits the backtest pipeline (Forecast Lab) may spend in
# one run. It estimates cost before running and aborts above this.
BACKTEST_CREDIT_CAP=600

# Max agent/fast calls (200 credits each) TIDE will make in a rolling hour,
# across the AI Anchor and "Ask the anchor" button combined. Reports are
# reused for an hour and only generated on a click, never on page load.
ANCHOR_MAX_PER_HOUR=3

# Scanner cadence in minutes (~15-35 credits per run; 30 = ~850/day).
SCAN_INTERVAL_MIN=30

# Storm sweep: every N hours the scanner scores the tokens smart money is
# dumping hardest (~17 credits each) so the home ticker has fresh scores.
STORM_SWEEP_HOURS=12
STORM_SWEEP_TOKENS=6

# Where the scanner/cache SQLite database lives. Relative to the repo root.
TIDE_DB_PATH=./data/tide.db

# Optional: only needed for "Set storm alert" delivery if you want alerts
# to reach a specific chat/webhook by default instead of asking the user
# for one each time.
TELEGRAM_DEFAULT_CHAT_ID=
DISCORD_DEFAULT_WEBHOOK_URL=
